# ============================================================
# debug-full — OpenShift/Kubernetes full debug toolbox
# Runs as non-root (UID 1001) — compatible with OpenShift SCC
# ============================================================
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

LABEL maintainer="platform-team" \
      description="Full debug toolbox for OpenShift/Kubernetes clusters" \
      version="1.0.0"

# ---------- versions (override at build time) ----------
ARG OC_VERSION=4.15.0
ARG KUBECTL_VERSION=v1.30.0
ARG TARGETARCH=amd64

# ---------- install base tools ----------
RUN microdnf update -y && \
    microdnf install -y \
        nmap \
        tcpdump \
        iperf3 \
        iptraf-ng \
        mtr \
        traceroute \
        curl \
        wget \
        git \
        bind-utils \
        net-tools \
        iproute \
        iputils \
        procps-ng \
        jq \
        bash \
        tar \
        gzip \
        ca-certificates && \
    microdnf clean all && \
    rm -rf /var/cache/dnf

# ---------- install oc client ----------
RUN curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OC_VERSION}/openshift-client-linux-${OC_VERSION}.tar.gz" \
        -o /tmp/oc.tar.gz && \
    tar -xzf /tmp/oc.tar.gz -C /usr/local/bin oc kubectl 2>/dev/null || \
    tar -xzf /tmp/oc.tar.gz -C /usr/local/bin oc && \
    chmod +x /usr/local/bin/oc && \
    rm -f /tmp/oc.tar.gz

# ---------- install kubectl (standalone, if not bundled with oc) ----------
RUN if [ ! -f /usr/local/bin/kubectl ]; then \
        curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
             -o /usr/local/bin/kubectl && \
        chmod +x /usr/local/bin/kubectl; \
    fi

# ---------- create non-root user (UID 1001 — OpenShift-friendly) ----------
RUN useradd -u 1001 -r -g 0 -d /home/debugger -s /bin/bash \
        -c "OpenShift Debug User" debugger && \
    mkdir -p /home/debugger && \
    chown -R 1001:0 /home/debugger && \
    chmod -R g=u /home/debugger

# ---------- allow tcpdump/nmap without root (cap_net_raw) ----------
RUN setcap cap_net_raw,cap_net_admin+eip /usr/sbin/tcpdump  2>/dev/null || true && \
    setcap cap_net_raw+eip /usr/bin/nmap 2>/dev/null || true

# ---------- shell helpers ----------
COPY --chown=1001:0 motd.sh /etc/profile.d/motd.sh
RUN chmod +x /etc/profile.d/motd.sh

WORKDIR /home/debugger
USER 1001

# Keep alive — replace with your own command or use as ephemeral debug pod
CMD ["bash", "-c", "cat /etc/profile.d/motd.sh; exec bash"]
